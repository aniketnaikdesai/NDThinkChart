/* Tailwind-inspired Dense Dark Theme */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11px;
    color: #a3a3a3; /* neutral-400 */
}

QMainWindow, QDialog, QWidget {
    background-color: #0d0f14;
}

QDockWidget {
    color: #e5e5e5; /* neutral-200 */
    font-weight: bold;
    titlebar-close-icon: url(close.png); /* Mock, adjust as needed */
    titlebar-normal-icon: url(float.png);
}

QDockWidget::title {
    background: #141822;
    padding-left: 5px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom: 1px solid #232938;
}

QTableWidget {
    background-color: #101218;
    border: 1px solid #2b3345;
    gridline-color: #232938;
    color: #a3a3a3;
    selection-background-color: #1f273a;
    selection-color: #e5e5e5;
}

QHeaderView::section {
    background-color: #141822;
    color: #e5e5e5;
    padding: 2px 4px;
    border: 1px solid #2b3345;
}

/* Numeric columns should ideally use tabular figures */
.Tabular {
    font-family: monospace;
}

/* Toolbars and Tabs */
QToolBar {
    background-color: #0d0f14;
    border-bottom: 1px solid #232938;
    padding: 2px;
}

QTabBar::tab {
    background: #101218;
    border: 1px solid #232938;
    border-bottom: none;
    padding: 4px 8px;
    color: #a3a3a3;
}

QTabBar::tab:selected {
    background: #141822;
    color: #e5e5e5;
    border-top: 2px solid #34d399; /* emerald-400 accent */
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0d0f14;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2b3345;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* Group boxes and check boxes */
QGroupBox {
    border: 1px solid #2b3345;
    border-radius: 4px;
    margin-top: 0;
    padding-top: 22px;
    background: #12151d;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 8px;
    top: 3px;
    padding: 0 4px;
    color: #e5e5e5;
}

QCheckBox::indicator, QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #64748b;
    border-radius: 3px;
    background: #171b24;
}

QCheckBox::indicator:hover, QGroupBox::indicator:hover {
    border-color: #94a3b8;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background: #34d399;
    border-color: #34d399;
}
